# Nexus Kit — yerel ayarlar. Bu dosyayı .env.local olarak kopyala; .env.local .gitignore içindedir ve dist'e girmez.
# Kit hiçbir anahtarı sunucuya göndermez; seçtiğin sağlayıcıya doğrudan gider.

# Sağlayıcı: claude-code | claude-api | ollama | astra | custom | none
NEXUS_AI_PROVIDER=none

# claude-api
ANTHROPIC_API_KEY=
NEXUS_AI_MODEL=            # boşsa client.mjs --list-models ile güncel görüntü destekli bir model seç

# ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=              # metin: gemma/qwen 7–9B · kroki: vision model

# astra (davet)
ASTRA_ASSIST_URL=
ASTRA_INVITE_KEY=

# custom
NEXUS_AI_COMMAND=          # stdin JSON zarfı → stdout JSON zarfı

# Yayın (yalnız gösterilir; kit çalıştırmaz)
NEXUS_PUBLISH_TARGET=vercel   # vercel | netlify | cloudflare | github-pages | manual
NEXUS_REGISTRY_REPO=nexus-interlink/nexus-registry
