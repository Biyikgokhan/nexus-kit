{
  "name": "nexus-kit",
  "version": "0.3.0",
  "description": "Open tools for independent stylized 3D places, creative workflows and HTTPS interlinks.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "bin": {
    "nexus-kit": "bin/nexus-kit.mjs"
  },
  "files": [
    "editor/",
    "ASSETS.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "LICENSE-APACHE",
    "NOTICE.md",
    "README.md",
    "ROADMAP.md",
    "SECURITY.md",
    "THIRD-PARTY.md",
    "TRADEMARKS.md",
    "bin",
    "docs",
    "harness",
    "lib",
    "schema",
    "templates",
    "wizard",
    "plugins",
    "mcp",
    "GOVERNANCE.md",
    "!docs/video/**",
    "!docs/img/*.png",
    "!docs/img/*.jpg",
    "!docs/img/*.gif"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "doctor": "node bin/nexus-kit.mjs doctor",
    "wizard": "node bin/nexus-kit.mjs wizard",
    "build:wizard": "vite build --config wizard/vite.config.mjs",
    "mcp": "node mcp/server.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Biyikgokhan/nexus-kit"
  },
  "keywords": [
    "three.js",
    "nexus-interlink",
    "3d",
    "wizard",
    "blender",
    "open-source"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "^3.25.76",
    "three": "0.186.1",
    "vite": "8.3.4",
    "fflate": "0.8.3"
  }
}
